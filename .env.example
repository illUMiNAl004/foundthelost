# Copy to .env.local and fill in. Without the Supabase vars the app runs in demo mode
# (local data, no real auth). On Netlify, set the same names under Site → Environment.

# ---- Supabase (Settings → API) -------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ---- Snap & Fill vision (SERVER-SIDE ONLY — no VITE_ prefix, never shipped to the browser)
# Open-weights Gemma 4 (multimodal). Set ONE provider; OpenRouter wins if both are present.
#   OpenRouter → https://openrouter.ai/keys        default model google/gemma-4-31b-it
#   Google AI Studio → https://aistudio.google.com  default model gemma-4-31b-it (free tier)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# optional: force a provider when both keys are set (openrouter | gemini)
VISION_PROVIDER=
# optional model override — an OpenRouter slug (contains "/") or a Gemini id, e.g.
#   google/gemma-4-26b-a4b-it:free   (OpenRouter $0 tier — shares Google's public pool, often 429)
#   gemma-4-31b-it                   (Gemini API, your own free quota — recommended for $0)
VISION_MODEL=

# ---- Launch switch --------------------------------------------------------------
# on (default): intro → waitlist screen, "sign in" link for people with access.
# off: intro → globe → sign-in over the campus map (the launched experience).
VITE_WAITLIST=on
